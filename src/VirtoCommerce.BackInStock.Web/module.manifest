<?xml version="1.0" encoding="utf-8"?>
<module>
  <id>VirtoCommerce.BackInStock</id>
  <version>3.1006.0</version>
  <version-tag></version-tag>

  <platformVersion>3.1101.0</platformVersion>
  <dependencies>
    <dependency id="VirtoCommerce.AdminAngularJs" version="3.1098.0" optional="true" />
    <dependency id="VirtoCommerce.AdminShell" version="3.1101.0" optional="true" />
    <dependency id="VirtoCommerce.Catalog" version="3.1048.0" />
    <dependency id="VirtoCommerce.Customer" version="3.1028.0" />
    <dependency id="VirtoCommerce.Inventory" version="3.1010.0" />
    <dependency id="VirtoCommerce.Notifications" version="3.1018.0" />
    <dependency id="VirtoCommerce.Store" version="3.1009.0" />
    <dependency id="VirtoCommerce.Xapi" version="3.1031.0" />
    <dependency id="VirtoCommerce.XCatalog" version="3.1025.0" />
  </dependencies>

  <title>Back In Stock</title>
  <description>Provides customer ability to subscribe for notification, when product is back in stock.</description>

  <authors>
    <author>Virto Commerce</author>
  </authors>
  <owners>
    <owner>Virto Commerce</owner>
  </owners>

  <projectUrl>https://github.com/VirtoCommerce/vc-module-back-in-stock</projectUrl>
  <iconUrl>Modules/$(VirtoCommerce.BackInStock)/Content/logo.svg</iconUrl>
  <requireLicenseAcceptance>false</requireLicenseAcceptance>

  <assemblyFile>VirtoCommerce.BackInStock.Web.dll</assemblyFile>
  <moduleType>VirtoCommerce.BackInStock.Web.Module, VirtoCommerce.BackInStock.Web</moduleType>

  <releaseNotes>First version.</releaseNotes>
  <copyright>Copyright © 2025-2026 Virto Commerce. All rights reserved</copyright>
  <tags>extension module</tags>
  <useFullTypeNameInSwagger>false</useFullTypeNameInSwagger>
</module>
